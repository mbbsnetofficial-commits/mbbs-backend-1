# Application
NODE_ENV=production
PUBLIC_API_URL=https://mbbs-backend-production-dc64.up.railway.app
FRONTEND_URL=https://your-frontend-domain.com

# MongoDB
CONNECTION_STRING=mongodb+srv://username:password@cluster.example.mongodb.net/database-name
# Optional: omit this when the blog database is in the same MongoDB cluster.
BLOG_CONNECTION_STRING=mongodb+srv://username:password@cluster.example.mongodb.net/blog
BLOG_DATABASE_NAME=blog

# Student authentication
SECRET_KEY=replace-with-a-long-random-secret
REFRESH_SECRET_KEY=replace-with-a-different-long-random-secret
LOGIN_EXPIRES=1h
REFRESH_TOKEN_EXPIRES=30d

# Calendar timezone used for Question of the Day streaks
APP_TIMEZONE=Asia/Kolkata

# Platform admin authentication
ADMIN_SECRET_KEY=replace-with-a-third-long-random-secret
ADMIN_LOGIN_EXPIRES=8h

# OTP hashing
RESET_OTP_SECRET=replace-with-a-long-random-secret
SIGNUP_OTP_SECRET=replace-with-another-long-random-secret

# Twilio SMS
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=replace-with-your-twilio-auth-token
TWILIO_PHONE_NUMBER=+10000000000

# Gemini
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=60000
GEMINI_MAX_OUTPUT_TOKENS=4096
GEMINI_TEMPERATURE=0.3

# Cloudinary media storage
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# API rate limiting (milliseconds and maximum requests per window)
RATE_LIMIT_API_WINDOW_MS=900000
RATE_LIMIT_API_MAX=300
RATE_LIMIT_LOGIN_WINDOW_MS=900000
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_SIGNUP_WINDOW_MS=3600000
RATE_LIMIT_SIGNUP_MAX=5
RATE_LIMIT_OTP_WINDOW_MS=600000
RATE_LIMIT_OTP_MAX=3
RATE_LIMIT_OTP_VERIFY_WINDOW_MS=900000
RATE_LIMIT_OTP_VERIFY_MAX=8
RATE_LIMIT_TOKEN_WINDOW_MS=900000
RATE_LIMIT_TOKEN_MAX=30
RATE_LIMIT_WRITE_WINDOW_MS=900000
RATE_LIMIT_WRITE_MAX=60
RATE_LIMIT_AI_WINDOW_MS=60000
RATE_LIMIT_AI_MAX=15
RATE_LIMIT_ADMIN_WINDOW_MS=900000
RATE_LIMIT_ADMIN_MAX=150
