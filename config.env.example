# Application
NODE_ENV=production
PUBLIC_API_URL=https://api.mbbs.net
# Required in production. Comma-separate every trusted browser origin.
# Browser origins are rejected in production when this is missing.
FRONTEND_URL=https://your-frontend-domain.com

# MongoDB
CONNECTION_STRING=mongodb+srv://username:password@cluster.example.mongodb.net/database-name
# Optional: omit this when the blog database is in the same MongoDB cluster.
BLOG_CONNECTION_STRING=mongodb+srv://username:password@cluster.example.mongodb.net/blog
BLOG_DATABASE_NAME=blog

# Student authentication
SECRET_KEY=replace-with-a-long-random-secret
REFRESH_SECRET_KEY=replace-with-a-different-long-random-secret
LOGIN_EXPIRES=1h
REFRESH_TOKEN_EXPIRES=30d

# Firebase Admin (Google login token verification)
# Create a Firebase service account for project mbbs-e6f31. Use either the
# three separate values below or FIREBASE_SERVICE_ACCOUNT_JSON, not both.
FIREBASE_PROJECT_ID=mbbs-e6f31
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-example@mbbs-e6f31.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-with-private-key\n-----END PRIVATE KEY-----\n"
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"mbbs-e6f31",...}

# Calendar timezone used for Question of the Day streaks
APP_TIMEZONE=Asia/Kolkata

# Platform admin authentication
ADMIN_SECRET_KEY=replace-with-a-third-long-random-secret
ADMIN_LOGIN_EXPIRES=8h

# OTP hashing
RESET_OTP_SECRET=replace-with-a-long-random-secret
SIGNUP_OTP_SECRET=replace-with-another-long-random-secret

# Twilio SMS
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=replace-with-your-twilio-auth-token
TWILIO_PHONE_NUMBER=+10000000000

# Email delivery for Google-account password setup links
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-with-smtp-username
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM="MBBS.NET <no-reply@mbbs.net>"
PASSWORD_SETUP_FRONTEND_URL=https://your-frontend-domain.com/set-password

# Gemini
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_MS=60000
GEMINI_MAX_OUTPUT_TOKENS=4096

# Cloudinary media storage
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# API rate limiting (milliseconds and maximum requests per window)
RATE_LIMIT_API_WINDOW_MS=900000
RATE_LIMIT_API_MAX=300
RATE_LIMIT_LOGIN_WINDOW_MS=900000
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_GOOGLE_LOGIN_WINDOW_MS=900000
RATE_LIMIT_GOOGLE_LOGIN_MAX=30
RATE_LIMIT_SIGNUP_WINDOW_MS=3600000
RATE_LIMIT_SIGNUP_MAX=5
RATE_LIMIT_OTP_WINDOW_MS=600000
RATE_LIMIT_OTP_MAX=3
RATE_LIMIT_OTP_VERIFY_WINDOW_MS=900000
RATE_LIMIT_OTP_VERIFY_MAX=8
RATE_LIMIT_TOKEN_WINDOW_MS=900000
RATE_LIMIT_TOKEN_MAX=30
RATE_LIMIT_WRITE_WINDOW_MS=900000
RATE_LIMIT_WRITE_MAX=60
RATE_LIMIT_AI_WINDOW_MS=60000
RATE_LIMIT_AI_MAX=15
RATE_LIMIT_ADMIN_WINDOW_MS=900000
RATE_LIMIT_ADMIN_MAX=150

# Swagger UI authentication
SWAGGER_PASSWORD=sas1627
# SWAGGER_USER=admin

