# Application
NODE_ENV=production
PUBLIC_API_URL=https://mbbs-backend-production-dc64.up.railway.app
FRONTEND_URL=https://your-frontend-domain.com

# MongoDB
CONNECTION_STRING=mongodb+srv://username:password@cluster.example.mongodb.net/database-name

# Student authentication
SECRET_KEY=replace-with-a-long-random-secret
REFRESH_SECRET_KEY=replace-with-a-different-long-random-secret
LOGIN_EXPIRES=1h
REFRESH_TOKEN_EXPIRES=30d

# Platform admin authentication
ADMIN_SECRET_KEY=replace-with-a-third-long-random-secret
ADMIN_LOGIN_EXPIRES=8h

# OTP hashing
RESET_OTP_SECRET=replace-with-a-long-random-secret
SIGNUP_OTP_SECRET=replace-with-another-long-random-secret

# Twilio SMS
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=replace-with-your-twilio-auth-token
TWILIO_PHONE_NUMBER=+10000000000

# Gemini
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=60000
GEMINI_MAX_OUTPUT_TOKENS=4096
GEMINI_TEMPERATURE=0.3
